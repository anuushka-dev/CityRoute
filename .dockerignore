# Python virtual environments
.venv/
venv/
env/

# Environment/secrets
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and documentation are not needed in the runtime image
tests/
docs/
*.md

# Local benchmark/output artifacts
benchmarks/
cache/

# Keep only the graphs used by CityRoute deployment images.
# Everything else under data stays outside the image.
data/*
!data/graphs/
data/graphs/*
!data/graphs/kanpur.graphml
!data/graphs/kanpur_central.graphml

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker / local runtime files
docker-compose.yml
*.log